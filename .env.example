# ============================================================
# AutoApply — environment variables template
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values in .env
# 3. NEVER commit .env  (it is already in .gitignore)
# 4. In GitHub Actions, these are set as Repository Secrets —
#    the .env file is never uploaded or used in the pipeline.
# ============================================================

# --- LLM (Gemini only — Anthropic not used) -----------------
GEMINI_API_KEY=

# --- GitHub PATs -------------------------------------------
# Read-only access to aaditn18/aadit_nilay_resume_swe (submodule)
SUBMODULE_PAT=

# Issues:write + Contents:write on aaditn18/AutoApply
GH_ISSUES_PAT=

# --- AES encryption key (for Phase 2 session cookies) -------
# Generate: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY_B64=

# --- Operational flags (safe to leave as defaults) ----------
DRY_RUN=true
# When true: only ingest test_safe companies (no quant funds / elite targets).
# Flip to false only after you've validated the pipeline end-to-end.
TEST_SAFE_ONLY=true
MAX_APPLICATIONS_PER_RUN=5
LOG_LEVEL=INFO
