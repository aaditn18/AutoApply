# ============================================================
# AutoApply — environment variables template
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values in .env
# 3. NEVER commit .env  (it is already in .gitignore)
# 4. In GitHub Actions, these are set as Repository Secrets —
#    the .env file is never uploaded or used in the pipeline.
# ============================================================

# --- LLM (Gemini only — Anthropic not used) -----------------
GEMINI_API_KEY=

# --- GitHub PATs -------------------------------------------
# Read-only access to aaditn18/aadit_nilay_resume_swe (submodule)
SUBMODULE_PAT=

# Issues:write + Contents:write on aaditn18/AutoApply
GH_ISSUES_PAT=

# --- AES encryption key (for Phase 2 session cookies) -------
# Generate: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY_B64=

# --- hCaptcha accessibility bypass (Lever) ------------------
# Register once at https://accounts.hcaptcha.com/accessibility
# Copy the `hc_accessibility` cookie value here.
HCAPTCHA_ACCESSIBILITY_TOKEN=

# --- Third-party captcha solver (optional, paid) -----------
# When AutoApply hits a blocking hCaptcha / reCAPTCHA v2, it can offload
# the challenge to a solving service. Cost is roughly $1–$3 per 1000
# hCaptcha solves depending on provider.
#   Supported: "anticaptcha", "capsolver", "2captcha", "2captcha_coords",
#              "capmonster"
#   anticaptcha:     register at https://anti-captcha.com
#                    → API key in dashboard. Recommended: hCaptcha works
#                      out-of-the-box, no account gating.
#   capsolver:       register at https://www.capsolver.com → API key.
#                    Note: proxy-less hCaptcha NOT supported for many sites.
#   2captcha:        register at https://2captcha.com → API key.
#                    SMART ROUTING: detects the captcha type on the page
#                    and dispatches via 2Captcha's JSON API v2 endpoints
#                    (api.2captcha.com/createTask + getTaskResult):
#                      - hCaptcha (any form) → GridTask. (Note: 2Captcha
#                        has dropped hCaptcha token solving entirely —
#                        their current docs don't list hCaptcha at all.
#                        The GridTask endpoint is their only working path
#                        for hCaptcha today, and it solves the image-grid
#                        "click each image containing X" puzzle.)
#                      - reCAPTCHA v2 → RecaptchaV2TaskProxyless.
#                      - Cloudflare Turnstile → TurnstileTaskProxyless.
#   2captcha_coords: legacy alias that forces the Grid path for any
#                    captcha. Use only for debugging. Same API key as
#                    "2captcha".
#   capmonster:      register at https://capmonster.cloud → API key.
# Leave blank to disable (any blocking captcha → outcome=captcha → review queue).
CAPTCHA_SOLVER=
CAPTCHA_SOLVER_API_KEY=
CAPTCHA_SOLVER_TIMEOUT=180

# --- Email verification (Greenhouse OTP) --------------------
# Some Greenhouse boards email a one-time code to confirm the applicant's
# address before accepting the application.  Fill these so AutoApply can
# fetch the code automatically via IMAP and complete verification.
#
# For terpmail.umd.edu (Google Workspace):
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to Google Account → Security → App Passwords.
#   3. Create an app password named "Mail / AutoApply".
#   4. Paste the 16-character code (no spaces) below.
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=aaditnilay18@gmail.com
IMAP_PASSWORD=

# --- Operational flags (safe to leave as defaults) ----------
DRY_RUN=true
# When true: only ingest test_safe companies (no quant funds / elite targets).
# Flip to false only after you've validated the pipeline end-to-end.
TEST_SAFE_ONLY=true
MAX_APPLICATIONS_PER_RUN=5
LOG_LEVEL=INFO
