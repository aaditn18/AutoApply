{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/secrets*)",
      "Read(**/*_secret*)",
      "Read(**/*credentials*)"
    ],
    "allow": [
      "Bash(.claude/bin/test.sh:*)",
      "Bash(.claude/bin/test-fast.sh:*)",
      "Bash(.claude/bin/dry.sh:*)",
      "Bash(.claude/bin/apply.sh:*)",
      "Bash(.claude/bin/applied.sh:*)",
      "Bash(.claude/bin/audit.sh:*)",
      "Bash(.claude/bin/security.sh:*)",
      "Bash(.claude/bin/classify.sh:*)",
      "Bash(.claude/bin/presubmit.sh:*)",
      "Bash(.claude/bin/push-safe.sh:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-fix.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/rules-smoke.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/docs-sync.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/context-dump.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/skill-hint.sh"
          }
        ]
      }
    ]
  }
}
