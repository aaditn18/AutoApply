# Dry-run artifacts (keep directory, ignore contents — safety net)
state/dry_runs/*.json
state/dry_runs/*.png
!state/dry_runs/.gitkeep

# Failed-submit debug dumps (screenshots, annotated captcha clicks, state)
# Useful locally, never committed — regenerated on every failed run.
state/failed_submits/

# Session states (encrypted; never commit raw)
state/session_*.json

# Local web app (api/ + web/) — see .claude/plans/lets-plan-how-to-lazy-rainbow.md
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
api/runs/
state/backups/

